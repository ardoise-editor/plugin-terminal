{
  "id": "ardoise.terminal",
  "name": { "en": "Terminal", "fr": "Terminal" },
  "version": "1.1.1",
  "api": 1,
  "description": {
    "en": "Shells in tabs under the editor, with their history, search, and paths a click away",
    "fr": "Des shells en onglets sous l'éditeur, avec leur historique, la recherche, et les chemins à un clic"
  },
  "author": "Ardoise Editor",
  "repository": "ardoise-editor/plugin-terminal",
  "license": "MIT",
  "command": ["bin/terminal"],
  "events": ["active_file"],
  "contributes": {
    "commands": [
      { "id": "terminal.toggle", "title": { "en": "Terminal: Show", "fr": "Terminal : afficher" } },
      { "id": "terminal.new", "title": { "en": "Terminal: New", "fr": "Terminal : nouveau" } },
      { "id": "terminal.here", "title": { "en": "Open in Terminal", "fr": "Ouvrir dans le terminal" }, "menus": ["folder", "file"] }
    ],
    "panels": [
      { "id": "terminal", "title": { "en": "Terminal", "fr": "Terminal" }, "icon": "", "location": "bottom" }
    ]
  }
}
